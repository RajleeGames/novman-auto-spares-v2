{% extends 'base.html' %}{% block page_title %}Receive Stock{% endblock %}{% block content %}<div class="page-head"><div><h1>Receive stock</h1><p>Buying cost may change on every purchase; the old batch cost remains unchanged.</p></div><a class="btn btn-secondary" href="{% url 'purchases' %}">Back</a></div><section class="card form-card"><form method="post" class="stack-form" id="purchaseForm">{% csrf_token %}<label>Product<select class="form-control" id="purchaseProduct" name="product" required><option value="">Choose product</option>{% for p in products %}<option value="{{ p.id }}">{{ p.name }} · base {{ p.base_unit }}</option>{% endfor %}</select></label><label>Purchase unit<select class="form-control" id="purchaseUnit" name="unit" required><option value="">Choose product first</option></select></label><div class="form-grid two"><label>Quantity<input class="form-control" name="quantity" inputmode="decimal" step="any" placeholder="e.g. 5" required></label><label>Cost per selected unit<input class="form-control" name="cost_per_unit" inputmode="decimal" step="any" placeholder="e.g. 8500" required></label></div><div class="form-grid two"><label>Supplier<input class="form-control" name="supplier_name" placeholder="Optional"></label><label>Invoice / reference<input class="form-control" name="invoice_number" placeholder="Optional"></label></div><label>Notes<textarea class="form-control" name="notes" rows="3" placeholder="Optional notes"></textarea></label><button class="btn btn-primary">Receive into stock</button></form></section>{% endblock %}{% block scripts %}<script>window.MFP_PURCHASE_UNITS={{ units_json|safe }};</script>{% endblock %}
