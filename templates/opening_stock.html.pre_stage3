{% extends 'base.html' %}{% block page_title %}Opening Stock{% endblock %}{% block content %}<div class="page-head"><div><h1>Add opening stock</h1><p>Use this for stock the business already owned before the system. It does not create a purchase.</p></div><a class="btn btn-secondary" href="{% url 'stock' %}">Back</a></div><section class="card form-card"><form method="post" class="stack-form">{% csrf_token %}<label>Product<select class="form-control" name="product" id="openingProduct" required><option value="">Choose product</option>{% for p in products %}<option value="{{ p.id }}">{{ p.name }} · base {{ p.base_unit }}</option>{% endfor %}</select></label><label>Stock unit<select class="form-control" name="unit" id="openingUnit" required><option value="">Choose product first</option></select></label><label>Quantity<input class="form-control" name="quantity" inputmode="decimal" step="any" placeholder="e.g. 3 trays or 24.5 KG" required></label><label>Known / estimated cost per selected unit<input class="form-control" name="cost_per_unit" inputmode="decimal" step="any" placeholder="e.g. 8500 per tray" required></label><label>Reference<input class="form-control" name="reference" placeholder="Opening stock count"></label><button class="btn btn-primary">Add opening stock batch</button></form></section>{% endblock %}{% block scripts %}<script>window.MFP_OPENING_UNITS={{ units_json|safe }};</script>{% endblock %}