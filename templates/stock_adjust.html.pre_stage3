{% extends 'base.html' %}{% block page_title %}Stock Adjustment{% endblock %}{% block content %}<div class="page-head"><div><h1>Adjust stock</h1><p>Record spoilage, loss, corrections or manual stock additions.</p></div><a class="btn btn-secondary" href="{% url 'stock' %}">Back</a></div><section class="card form-card"><form method="post" class="stack-form">{% csrf_token %}<label>Product<select class="form-control" name="product" required>{% for p in products %}<option value="{{ p.id }}">{{ p.name }} · {{ p.base_unit }}</option>{% endfor %}</select></label><label>Type<select class="form-control" name="adjustment_type" id="adjustType"><option value="decrease">Decrease (spoilage/loss)</option><option value="increase">Increase (correction)</option></select></label><label>Quantity in base unit<input class="form-control" name="quantity" inputmode="decimal" step="any" placeholder="e.g. 1.5" required></label><label id="adjustCostWrap" class="hidden">Cost per base unit for added stock<input class="form-control" name="unit_cost" inputmode="decimal" step="any" placeholder="e.g. 7000"></label><label>Reason<input class="form-control" name="reason" placeholder="e.g. 1.5 KG spoiled" required></label><button class="btn btn-primary">Save adjustment</button></form></section>{% endblock %}
